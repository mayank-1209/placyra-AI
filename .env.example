# ==============================================================================
# PLACYRA ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Placyra - AI Campus Placement Assistant"

# MySQL 8.0 Relational Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=placyra_db
MYSQL_USER=placyra_user
MYSQL_PASSWORD=placyra_secret_pass
MYSQL_ROOT_PASSWORD=placyra_root_pass

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_QUESTIONS=company_questions
QDRANT_COLLECTION_RESUMES=student_resumes

# Ollama Local AI & Embedding Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Security & Authentication (JWT)
JWT_SECRET_KEY=placyra_super_secret_jwt_key_2026_campus_placement_assistant_token_seed
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Uploads Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# CORS & Frontend Origins
CORS_ORIGINS=["http://localhost:4000","http://127.0.0.1:4000","http://localhost:3000","http://localhost:5173","http://localhost:80","http://localhost"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
